{
  "modelId": "cnn-v1",

  "modelType": "CNN",

  "predictionType": "CLASSIFICATION",

  "endpoint": "http://127.0.0.1:8000/predict/cnn-v1",

  "description": "A simple CNN model that forecasts whether a stock will go up by at least 0.1% within 10 minutes",

  "input": {
    "interval": "FIVE_MINUTES",

    "batchSize": 10,

    "features": [
      "open",
      "high",
      "low",
      "close",
      "volume"
    ]
  },

  "output": {
    "positiveClassLabel": "UP",

    "horizonMinutes": 10
  },

  "version": "1.0.0"
}